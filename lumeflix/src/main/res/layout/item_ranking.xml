<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="161dp"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/row_focus"
    android:focusable="true"
    
    android:padding="4dp">

    <TextView android:id="@+id/capaRanking" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_gravity="start|bottom"
        android:fontFamily="sans-serif-condensed" android:textStyle="bold" android:includeFontPadding="false"
        android:textSize="108dp" android:textColor="#888888" android:importantForAccessibility="no" />

    <FrameLayout
        android:layout_width="126dp"
        android:layout_gravity="end"
        android:layout_height="190dp"
        android:background="@drawable/painel_banner"
        android:clipToOutline="true">

        <TextView
            android:id="@+id/capaInicial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:textColor="@color/accent"
            android:textSize="30sp"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/capaImagem"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <!-- Onde o filme parou, na borda de baixo da capa. -->
        <ProgressBar
            android:id="@+id/capaProgresso"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_gravity="bottom"
            android:max="1000"
            android:progressDrawable="@drawable/progress_track"
            android:visibility="gone" />
        <TextView android:id="@+id/capaNome" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_gravity="bottom"
            android:padding="6dp" android:textColor="@color/text_primary" android:textSize="14sp" />
    </FrameLayout>
</FrameLayout>
